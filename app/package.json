{
  "name": "cmmc-self-assessment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "gen": "node --experimental-strip-types scripts/gen-catalogue.mts",
    "prebuild": "pnpm run gen",
    "pretest": "pnpm run gen",
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src scripts tests",
    "e2e": "playwright test",
    "check:codegen": "pnpm run gen && git diff --exit-code -- src/generated",
    "test:all": "vitest run && vite build && vitest run tests/privacy.test.ts && playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.26.0",
    "fast-check": "^4.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^7.0.0",
    "vitest": "^3.1.0"
  }
}
